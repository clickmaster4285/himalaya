# Himalaya Villas frontend — example environment.
# Copy to .env.local (development) or set in the production process environment.
# Never commit real values.

# Public site origin (canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://himalayavillas.com

# Express backend (bookings, auth, uploads) used by the /api proxy
BACKEND_INTERNAL_URL=http://127.0.0.1:5000

# ClickMasters ERP CMS integration (server-only — never prefix with NEXT_PUBLIC_)
# The ERP *backend* API host. erp.clickmasters.pk is the ERP web app, not the API.
CMS_API_URL=https://apierp.clickmasters.pk
# The domain this site is registered under in the ERP (Digital Operations → Websites)
CMS_SITE_DOMAIN=himalayavillas.com

# Shared secret for POST /api/erp-revalidate (ERP calls it on publish/unpublish).
# Use a long random value and set the SAME value in the ERP backend environment.
ERP_REVALIDATE_SECRET=
